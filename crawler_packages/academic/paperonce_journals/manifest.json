{
  "protocol_version": "1.0",
  "package_key": "paperonce_journals",
  "package_version": "1.1.3",
  "name": "PaperOnce 期刊当期包",
  "description": "读取 PaperOnce 期刊官网公开 LastIssueList API，回迁 2377 目录中当期目次验证通过的期刊",
  "category": "academic",
  "runtime": {
    "type": "python",
    "python_version": "3.14",
    "entrypoint": "crawler.py",
    "dependencies": "requirements.lock"
  },
  "capabilities": {
    "incremental": false
  },
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "journal_keys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 78,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16
        },
        "default": [
          "3a9650563fbbaa0c",
          "f198a29e7799cba4",
          "a33c913cc6cee7e9",
          "c7821232bee71426",
          "6c15f016b37f1e6c",
          "ebdcd1eabd86259f",
          "65c03f069d6c21c3",
          "0f9b35919718185a",
          "897131ec50bcdcfc",
          "8c2d02290137f6ac"
        ]
      },
      "collect_mode": {
        "type": "string",
        "enum": [
          "latest_issue",
          "keywords"
        ],
        "default": "latest_issue",
        "description": "keywords 仅对当期目次做本地关键词过滤，不是全刊检索；latest_issue 返回整期。"
      },
      "per_journal_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 50
      },
      "enrich_abstract": {
        "type": "boolean",
        "default": true,
        "description": "latest_issue 模式下为缺摘要文章抓取详情页摘要（span#LbZY 优先，行内 摘要： 兜底）；仅填空、不覆盖已有摘要；仅保存文本，不下载 PDF。"
      },
      "abstract_enrich_limit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10,
        "default": 5,
        "description": "每本期刊最多补抓摘要的文章数，0 表示关闭。"
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 60,
        "default": 20
      }
    },
    "additionalProperties": false
  },
  "secret_names": [],
  "output_schema_version": 1,
  "output_schema": {
    "fields": [
      {
        "name": "journal_key",
        "type": "string",
        "max_length": 16,
        "nullable": false
      },
      {
        "name": "journal_name",
        "type": "string",
        "max_length": 255,
        "nullable": false
      },
      {
        "name": "journal_url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "external_id",
        "type": "string",
        "max_length": 128,
        "nullable": false
      },
      {
        "name": "title",
        "type": "string",
        "max_length": 1000,
        "nullable": false
      },
      {
        "name": "url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "authors",
        "type": "text",
        "nullable": true
      },
      {
        "name": "abstract",
        "type": "text",
        "nullable": true
      },
      {
        "name": "doi",
        "type": "string",
        "max_length": 255,
        "nullable": true
      },
      {
        "name": "year",
        "type": "integer",
        "nullable": true
      },
      {
        "name": "issue",
        "type": "string",
        "max_length": 64,
        "nullable": true
      },
      {
        "name": "source_api",
        "type": "string",
        "max_length": 32,
        "nullable": false
      }
    ],
    "identity_fields": [
      "journal_key",
      "external_id"
    ],
    "indexes": [
      [
        "journal_key"
      ],
      [
        "doi"
      ],
      [
        "year"
      ]
    ],
    "mapping": {
      "title": "title",
      "url": "url",
      "summary": "abstract"
    }
  }
}
