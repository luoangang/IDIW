{
  "protocol_version": "1.0",
  "package_key": "foreign_q1_journals",
  "package_version": "1.1.1",
  "name": "国外 Q1 期刊包",
  "description": "基于 JCR 2025 Q1 全学科 watchlist（仅 include_daily=yes 的 5,238 本，排除 41 本 Inactive），标注 JCR 出版周期/每年期数/频次等级；通过 OpenAlex/Crossref 公开 API 采集文章元数据与链接；只用 DOI 身份，不下载 PDF。",
  "category": "academic",
  "runtime": {
    "type": "python",
    "python_version": "3.14",
    "entrypoint": "crawler.py",
    "dependencies": "requirements.lock"
  },
  "capabilities": {
    "incremental": false
  },
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "journal_keys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5238,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "default": [
          "3989ce4587723287",
          "17c3bd1ad95170d6",
          "f2367bee1edbbfb4",
          "ed4b576d8e4d6bfe",
          "076c134dbfec19c8",
          "dc64d52c219a88bb",
          "b9531bb9ec74d645",
          "3212addc29cb1df8",
          "0a83a1efd0a6f5d9",
          "46aa99f067b9baf9",
          "ccfa41db57339fa6",
          "4862d3a50b2ca984",
          "bdefd919fcf67b88",
          "4ee8a4cbba6e1c2f",
          "eab38fa1e0fb2d2c",
          "365029feb41fdda6",
          "bead29fdf60e8c74",
          "9e10039bdaaf5513",
          "9dbd463143afc0f9",
          "be73645e51c43d29"
        ]
      },
      "collect_mode": {
        "type": "string",
        "enum": [
          "keywords",
          "latest_issue",
          "bulk_window"
        ],
        "default": "keywords"
      },
      "bulk_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 100
      },
      "search_terms": {
        "type": "array",
        "maxItems": 10,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "default": []
      },
      "lookback_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 90,
        "default": 30
      },
      "per_journal_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 120,
        "default": 25
      },
      "require_abstract": {
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "secret_names": [
    "OPENALEX_API_KEY"
  ],
  "output_schema_version": 1,
  "output_schema": {
    "fields": [
      {
        "name": "doi",
        "type": "string",
        "max_length": 255,
        "nullable": false
      },
      {
        "name": "journal_key",
        "type": "string",
        "max_length": 64,
        "nullable": false
      },
      {
        "name": "journal_name",
        "type": "string",
        "max_length": 255,
        "nullable": false
      },
      {
        "name": "issn",
        "type": "string",
        "max_length": 16,
        "nullable": false
      },
      {
        "name": "title",
        "type": "string",
        "max_length": 1000,
        "nullable": false
      },
      {
        "name": "url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "authors",
        "type": "array",
        "nullable": false,
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      {
        "name": "affiliations",
        "type": "array",
        "nullable": false,
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      {
        "name": "abstract",
        "type": "text",
        "nullable": true
      },
      {
        "name": "published_at",
        "type": "date",
        "nullable": true
      },
      {
        "name": "year",
        "type": "integer",
        "nullable": true
      },
      {
        "name": "volume",
        "type": "string",
        "max_length": 64,
        "nullable": true
      },
      {
        "name": "issue",
        "type": "string",
        "max_length": 64,
        "nullable": true
      },
      {
        "name": "pages",
        "type": "string",
        "max_length": 128,
        "nullable": true
      },
      {
        "name": "language",
        "type": "string",
        "max_length": 16,
        "nullable": true
      },
      {
        "name": "open_access",
        "type": "boolean",
        "nullable": true
      },
      {
        "name": "cited_by_count",
        "type": "integer",
        "nullable": true
      },
      {
        "name": "source_api",
        "type": "string",
        "max_length": 16,
        "nullable": false
      },
      {
        "name": "openalex_id",
        "type": "string",
        "max_length": 128,
        "nullable": true
      },
      {
        "name": "matched_terms",
        "type": "array",
        "nullable": false,
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    ],
    "identity_fields": [
      "doi"
    ],
    "indexes": [
      [
        "journal_key"
      ],
      [
        "year"
      ],
      [
        "published_at"
      ]
    ],
    "mapping": {
      "title": "title",
      "url": "url",
      "summary": "abstract",
      "published_at": "published_at"
    }
  }
}
