{
  "protocol_version": "1.0",
  "package_key": "oa_rss_journals",
  "package_version": "1.1.1",
  "name": "高校期刊 OA RSS 当期包",
  "description": "读取期刊官网公开 /oa/rss.aspx 当期 RSS，收录 2377 目录中 18 本 RSS 当期可解析的期刊",
  "category": "academic",
  "runtime": {
    "type": "python",
    "python_version": "3.14",
    "entrypoint": "crawler.py",
    "dependencies": "requirements.lock"
  },
  "capabilities": {
    "incremental": false
  },
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "journal_keys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16
        },
        "default": [
          "c3cd23730ecaa89d",
          "fc21d96bc64a4bca",
          "7934fe4fdd274b89",
          "36d74fb9189ffe5b",
          "9f53855ac96e8237",
          "4c6f43d6d18067e4",
          "0b27df440c8c6497",
          "e7f68c87b158e4bc",
          "4fb71bd5b0fdc82a",
          "0c2a365ad24fa663",
          "6883c4aabead225f",
          "b79dfd7c29f4ddc0",
          "1de78b1d689d5ac5",
          "cf51edbf91bded2e",
          "23217b7a1ea453dd",
          "30b792b02c003abc",
          "817e0fdddbace580",
          "83ae1d19d34179a3"
        ]
      },
      "collect_mode": {
        "type": "string",
        "enum": [
          "latest_issue",
          "keywords"
        ],
        "default": "latest_issue",
        "description": "keywords 仅对当期目次做本地关键词过滤，不是全刊检索；latest_issue 返回整期。"
      },
      "per_journal_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 50
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 60,
        "default": 20
      }
    },
    "additionalProperties": false
  },
  "secret_names": [],
  "output_schema_version": 1,
  "output_schema": {
    "fields": [
      {
        "name": "journal_key",
        "type": "string",
        "max_length": 16,
        "nullable": false
      },
      {
        "name": "journal_name",
        "type": "string",
        "max_length": 255,
        "nullable": false
      },
      {
        "name": "journal_url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "external_id",
        "type": "string",
        "max_length": 128,
        "nullable": false
      },
      {
        "name": "title",
        "type": "string",
        "max_length": 1000,
        "nullable": false
      },
      {
        "name": "url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "authors",
        "type": "text",
        "nullable": true
      },
      {
        "name": "abstract",
        "type": "text",
        "nullable": true
      },
      {
        "name": "doi",
        "type": "string",
        "max_length": 255,
        "nullable": true
      },
      {
        "name": "year",
        "type": "integer",
        "nullable": true
      },
      {
        "name": "issue",
        "type": "string",
        "max_length": 64,
        "nullable": true
      },
      {
        "name": "source_api",
        "type": "string",
        "max_length": 32,
        "nullable": false
      }
    ],
    "identity_fields": [
      "journal_key",
      "external_id"
    ],
    "indexes": [
      [
        "journal_key"
      ],
      [
        "doi"
      ],
      [
        "year"
      ]
    ],
    "mapping": {
      "title": "title",
      "url": "url",
      "summary": "abstract"
    }
  }
}
