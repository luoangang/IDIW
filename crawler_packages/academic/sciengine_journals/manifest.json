{
  "protocol_version": "1.0",
  "package_key": "sciengine_journals",
  "package_version": "1.0.1",
  "name": "SciEngine 当期期刊包",
  "description": "读取 SciEngine 公开 JSON API 获取 14 本国内期刊的最新一期文章元数据，默认先发现最新卷期，失败时回退固定快照；只保存 PDF 链接，不下载全文。",
  "category": "academic",
  "runtime": {
    "type": "python",
    "python_version": "3.14",
    "entrypoint": "crawler.py",
    "dependencies": "requirements.lock"
  },
  "capabilities": {
    "incremental": false
  },
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "journal_keys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 14,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16
        },
        "default": [
          "a2a415ad37482923",
          "8b235c89e71721e7",
          "85b4c55efb8b5ad7",
          "93228fce19fb1a2e",
          "b85cac1cb2958ea4",
          "a48d3b84257ff923",
          "ed8cd492a666cc73",
          "6c2a3053752a74d4",
          "cf8a6fd80037d70e",
          "1b8f9acf33ba5c52",
          "b091eaadec1bbf73",
          "9e040efd13654a92",
          "2aa4728885d150a2",
          "bc2a09d5b761f0a4"
        ]
      },
      "collect_mode": {
        "type": "string",
        "enum": [
          "latest_issue"
        ],
        "default": "latest_issue",
        "description": "读取最新一期文章；默认先调用最新卷期接口，接口不可用或最新期无有效文章时回退 journals.json 中已核验的当期快照。"
      },
      "follow_latest": {
        "type": "boolean",
        "default": true,
        "description": "为 true 时每次先发现最新卷期并动态拼文章接口；为 false 时只读 journals.json 的固定当期快照。"
      },
      "per_journal_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 60,
        "default": 20
      }
    },
    "additionalProperties": false
  },
  "secret_names": [],
  "output_schema_version": 1,
  "output_schema": {
    "fields": [
      {
        "name": "journal_key",
        "type": "string",
        "max_length": 16,
        "nullable": false
      },
      {
        "name": "journal_name",
        "type": "string",
        "max_length": 255,
        "nullable": false
      },
      {
        "name": "journal_url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "external_id",
        "type": "string",
        "max_length": 128,
        "nullable": false
      },
      {
        "name": "title",
        "type": "string",
        "max_length": 1000,
        "nullable": false
      },
      {
        "name": "url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "authors",
        "type": "text",
        "nullable": true
      },
      {
        "name": "abstract",
        "type": "text",
        "nullable": true
      },
      {
        "name": "doi",
        "type": "string",
        "max_length": 255,
        "nullable": false
      },
      {
        "name": "year",
        "type": "integer",
        "nullable": true
      },
      {
        "name": "issue",
        "type": "string",
        "max_length": 64,
        "nullable": true
      },
      {
        "name": "volume",
        "type": "string",
        "max_length": 64,
        "nullable": true
      },
      {
        "name": "pages",
        "type": "string",
        "max_length": 128,
        "nullable": true
      },
      {
        "name": "source_api",
        "type": "string",
        "max_length": 32,
        "nullable": false
      },
      {
        "name": "pdf_url",
        "type": "text",
        "nullable": true
      }
    ],
    "identity_fields": [
      "journal_key",
      "external_id"
    ],
    "indexes": [
      [
        "journal_key"
      ],
      [
        "doi"
      ],
      [
        "year"
      ]
    ],
    "mapping": {
      "title": "title",
      "url": "url",
      "summary": "abstract"
    }
  }
}
