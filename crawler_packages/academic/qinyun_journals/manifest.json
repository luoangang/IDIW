{
  "protocol_version": "1.0",
  "package_key": "qinyun_journals",
  "package_version": "1.9.5",
  "name": "勤云中文期刊检索包",
  "description": "按关键词检索已验证的勤云新版 AJAX 与旧版 ASP.NET 期刊",
  "category": "academic",
  "runtime": {
    "type": "python",
    "python_version": "3.14",
    "entrypoint": "crawler.py",
    "dependencies": "requirements.lock"
  },
  "capabilities": {
    "incremental": false
  },
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "journal_keys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 173,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "default": [
          "jos",
          "3a5a26e2da18240d",
          "7643277e0c29c409",
          "870df8ed9e9efd94",
          "a747bc7179189244",
          "4df972b6bbda28c0",
          "7cc23519f38060d0",
          "ed8ab90b0cc756be",
          "8059cc0c71987788",
          "f87edecf88ab697f",
          "20515da4e88d71c5",
          "76391421314f5f5c",
          "e18133e715dd9a00",
          "3c1b46c38f3e14ac",
          "c9309ee32a6076cc",
          "3e3eef80705b9bff"
        ]
      },
      "collect_mode": {
        "type": "string",
        "enum": [
          "keywords",
          "latest_issue"
        ],
        "default": "keywords",
        "description": "latest_issue 读取当期目次；仅当页面存在同一期分页链接时顺序补页（最多 20 页，0 新增/跨期即停）。"
      },
      "per_journal_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 20
      },
      "enrich_abstract": {
        "type": "boolean",
        "default": true,
        "description": "latest_issue 模式下为缺摘要文章抓取详情页摘要；仅保存文本，不下载 PDF。"
      },
      "abstract_enrich_limit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20,
        "default": 5,
        "description": "每本期刊最多尝试补抓摘要的文章数，0 表示关闭。"
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 60,
        "default": 20
      }
    },
    "additionalProperties": false
  },
  "secret_names": [],
  "output_schema_version": 1,
  "output_schema": {
    "fields": [
      {
        "name": "journal_key",
        "type": "string",
        "max_length": 16,
        "nullable": false
      },
      {
        "name": "journal_name",
        "type": "string",
        "max_length": 255,
        "nullable": false
      },
      {
        "name": "journal_url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "external_id",
        "type": "string",
        "max_length": 128,
        "nullable": false
      },
      {
        "name": "title",
        "type": "string",
        "max_length": 1000,
        "nullable": false
      },
      {
        "name": "url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "authors",
        "type": "text",
        "nullable": true
      },
      {
        "name": "abstract",
        "type": "text",
        "nullable": true
      },
      {
        "name": "doi",
        "type": "string",
        "max_length": 255,
        "nullable": true
      },
      {
        "name": "year",
        "type": "integer",
        "nullable": true
      }
    ],
    "identity_fields": [
      "journal_key",
      "external_id"
    ],
    "indexes": [
      [
        "journal_key"
      ],
      [
        "doi"
      ],
      [
        "year"
      ]
    ],
    "mapping": {
      "title": "title",
      "url": "url",
      "summary": "abstract"
    }
  }
}
