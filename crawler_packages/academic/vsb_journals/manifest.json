{
  "protocol_version": "1.0",
  "package_key": "vsb_journals",
  "package_version": "1.2.5",
  "name": "高校 VSB 当期目次包",
  "description": "读取高校期刊 VSB sitebuilder 官网当期目录 HTML，收录 2377 目录中 12 本当期文章入口可解析的期刊",
  "category": "academic",
  "runtime": {
    "type": "python",
    "python_version": "3.14",
    "entrypoint": "crawler.py",
    "dependencies": "requirements.lock"
  },
  "capabilities": {
    "incremental": false
  },
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "journal_keys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 14,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16
        },
        "default": [
          "bca1715978e6821d",
          "c2acca12953dbda5",
          "e245799434449a85",
          "b13c4c952f222dc9",
          "349da8367a0043ca",
          "d6405c8c178437a2",
          "c87a910f542294e8",
          "dc5782791704b55f",
          "3d1be8e2beaa84f3",
          "91743b9fb6cf357a",
          "e9eb381d88924ab8",
          "a03529025b270e3b",
          "2700f90cbc65247d",
          "c632d8a102930bd0"
        ]
      },
      "collect_mode": {
        "type": "string",
        "enum": [
          "latest_issue",
          "keywords"
        ],
        "default": "latest_issue",
        "description": "keywords 仅对当期目次做本地关键词过滤，不是全刊检索；latest_issue 返回整期。"
      },
      "per_journal_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 50
      },
      "enrich_abstract": {
        "type": "boolean",
        "default": true,
        "description": "latest_issue 模式下为缺摘要文章抓详情页摘要（meta description 长度>100、div.article-abstract、【摘要】、行内 摘要：）；跳过 kns.cnki.net 与仅 PDF 页面；仅填空、不覆盖已有摘要。"
      },
      "abstract_enrich_limit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10,
        "default": 5,
        "description": "每本期刊最多补抓摘要的文章数，0 表示关闭。"
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 60,
        "default": 20
      }
    },
    "additionalProperties": false
  },
  "secret_names": [],
  "output_schema_version": 1,
  "output_schema": {
    "fields": [
      {
        "name": "journal_key",
        "type": "string",
        "max_length": 16,
        "nullable": false
      },
      {
        "name": "journal_name",
        "type": "string",
        "max_length": 255,
        "nullable": false
      },
      {
        "name": "journal_url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "external_id",
        "type": "string",
        "max_length": 128,
        "nullable": false
      },
      {
        "name": "title",
        "type": "string",
        "max_length": 1000,
        "nullable": false
      },
      {
        "name": "url",
        "type": "text",
        "nullable": false
      },
      {
        "name": "authors",
        "type": "text",
        "nullable": true
      },
      {
        "name": "abstract",
        "type": "text",
        "nullable": true
      },
      {
        "name": "doi",
        "type": "string",
        "max_length": 255,
        "nullable": true
      },
      {
        "name": "year",
        "type": "integer",
        "nullable": true
      },
      {
        "name": "issue",
        "type": "string",
        "max_length": 64,
        "nullable": true
      },
      {
        "name": "source_api",
        "type": "string",
        "max_length": 32,
        "nullable": false
      }
    ],
    "identity_fields": [
      "journal_key",
      "external_id"
    ],
    "indexes": [
      [
        "journal_key"
      ],
      [
        "doi"
      ],
      [
        "year"
      ]
    ],
    "mapping": {
      "title": "title",
      "url": "url",
      "summary": "abstract"
    }
  }
}
