{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/crawler-platform/v1/output-schema.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields", "identity_fields", "indexes", "mapping"],
  "properties": {
    "fields": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "type", "nullable"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
          "type": {"enum": ["string", "text", "integer", "decimal", "boolean", "date", "datetime", "array", "object"]},
          "nullable": {"type": "boolean"}, "max_length": {"type": "integer", "minimum": 1, "maximum": 1000},
          "precision": {"type": "integer", "minimum": 1, "maximum": 38}, "scale": {"type": "integer", "minimum": 0},
          "schema": {"type": "object"}
        }
      }
    },
    "identity_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "indexes": {"type": "array", "maxItems": 8, "items": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}}},
    "mapping": {
      "type": "object", "additionalProperties": false, "required": ["title"],
      "properties": {"title": {"type": "string"}, "url": {"type": "string"}, "summary": {"type": "string"}, "published_at": {"type": "string"}}
    }
  }
}
